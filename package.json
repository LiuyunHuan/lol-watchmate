{
  "name": "lol-watchmate",
  "version": "0.5.1",
  "private": true,
  "description": "LOL 观赛搭子：认真聊比赛，适时开个串",
  "author": "LOL Watchmate contributors",
  "license": "MIT",
  "main": "dist/main.cjs",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "postinstall": "install-electron",
    "dev": "node scripts/dev.mjs",
    "build": "node scripts/prepare-ocr.mjs && tsc --noEmit && vite build && node scripts/build-electron.mjs",
    "start": "electron .",
    "test": "vitest run",
    "test:desktop": "node scripts/smoke.mjs",
    "test:capture": "node scripts/live-smoke.mjs",
    "test:death-trigger": "node scripts/death-trigger-smoke.mjs",
    "check": "tsc --noEmit",
    "pack": "npm run build && electron-builder --win --dir",
    "dist": "npm run build && electron-builder --win nsis --publish never",
    "test:local": "node scripts/local-smoke.mjs",
    "test:broadcast": "node scripts/broadcast-smoke.mjs",
    "test:broadcast-capture": "node scripts/broadcast-capture.mjs",
    "test:recognition": "node scripts/recognition-regression.mjs",
    "assets:hud-font": "node scripts/train-hud-font.mjs",
    "assets:champion-variants": "node scripts/champion-variants.mjs",
    "test:memes": "node scripts/memes-smoke.mjs",
    "test:hupu": "node scripts/verify-hupu.mjs",
    "test:hupu:live": "node scripts/verify-hupu.mjs --live-qwen"
  },
  "dependencies": {
    "@tesseract.js-data/chi_sim": "^1.0.0",
    "@tesseract.js-data/eng": "^1.0.0",
    "jsfeat": "0.0.8",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tesseract.js": "^6.0.1",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.7.0",
    "electron": "^44.9.1",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.25.0",
    "playwright": "^1.56.0",
    "typescript": "^5.9.0",
    "vite": "^6.4.0",
    "vitest": "^3.2.0"
  },
  "build": {
    "appId": "io.watchmate.lol",
    "electronDist": "node_modules/electron/dist",
    "productName": "LOL观赛搭子",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "resources",
        "to": "resources"
      }
    ],
    "win": {
      "target": "nsis",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "artifactName": "LOL-Watchmate-${version}-Setup.${ext}"
  }
}
